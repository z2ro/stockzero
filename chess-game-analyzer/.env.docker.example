# Docker Compose defaults. /app is the container workdir.
DATABASE_URL=sqlite:////app/data/chess_analyzer.db
DATA_DIR=/app/data

# Dockerfile installs the distribution stockfish package at this path.
# To guarantee Stockfish 18, mount or bake your Stockfish 18 binary and point this variable to it.
STOCKFISH_PATH=/usr/games/stockfish
STOCKFISH_DEPTH=16
STOCKFISH_MULTIPV=3
# STOCKFISH_MOVE_TIME_MS=500

CHESSCOM_USER_AGENT=chess-game-analyzer/0.1 docker-compose
API_PORT=8000
FRONTEND_PORT=8501
